<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <!-- Desktop version train, also used by UpdateChecker. -->
    <Version>0.8.1</Version>
    <RootNamespace>Rally.App</RootNamespace>
    <ApplicationIcon>Assets\rally.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged (WindowsPackageType None): side-loadable exe, no Store cert needed yet. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.260224002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.22621.2428" />
    <PackageReference Include="LibVLCSharp.WinUI" Version="3.10.1" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rally.Core\Rally.Core.csproj" />
  </ItemGroup>

  <!-- The unpackaged WinUI build copies XBF/PRI to bin, but the .NET
       publish file list does not include them automatically. -->
  <Target Name="PublishRallyXamlResources" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <_RallyXamlPayload Include="$(TargetDir)**\*.xbf;$(TargetDir)$(AssemblyName).pri" />
      <ResolvedFileToPublish Include="@(_RallyXamlPayload)">
        <RelativePath>$([MSBuild]::MakeRelative('$(TargetDir)', '%(_RallyXamlPayload.FullPath)'))</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
