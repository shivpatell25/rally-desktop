<Page
    x:Class="Rally.App.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource RallyBackground}">
    <Grid Padding="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock Text="RALLY · GLOBAL SEARCH" Foreground="{StaticResource RallyAccent}" FontSize="11" FontWeight="Bold" />
            <TextBlock Text="Search" FontSize="28" FontWeight="Bold" />
            <TextBlock Text="Games, favorite teams, leagues, channels and addon streams" FontSize="13" Opacity="0.7" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <TextBox x:Name="QueryBox" Width="440" PlaceholderText="Team, game, league or channel"
                TextChanged="QueryBox_TextChanged" />
            <ProgressRing x:Name="Spinner" IsActive="False" Width="24" Height="24" />
            <TextBlock x:Name="IndexNote" VerticalAlignment="Center" FontSize="12" Opacity="0.7" Text="Loading index…" />
        </StackPanel>
        <ScrollViewer Grid.Row="2">
            <StackPanel Spacing="8">
                <TextBlock x:Name="ErrorText" Visibility="Collapsed" Foreground="{StaticResource RallyLive}"
                    TextWrapping="Wrap" />
                <TextBlock x:Name="EmptyText" Opacity="0.7" Text="Start typing to search every source."
                    TextWrapping="Wrap" />
                <TextBlock x:Name="GamesHeader" Text="Games" FontSize="19" FontWeight="Bold" Visibility="Collapsed" />
                <ListView x:Name="Games" SelectionMode="Single" MaxHeight="320"
                    SelectionChanged="Games_SelectionChanged" Visibility="Collapsed">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="8" Background="{StaticResource RallySurface}" CornerRadius="8">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Subtitle}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="TeamsHeader" Text="My Teams" FontSize="19" FontWeight="Bold" Visibility="Collapsed" />
                <ListView x:Name="Teams" SelectionMode="Single" MaxHeight="240"
                    SelectionChanged="Teams_SelectionChanged" Visibility="Collapsed">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="8" Background="{StaticResource RallySurface}" CornerRadius="8">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Subtitle}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="LeaguesHeader" Text="Leagues" FontSize="19" FontWeight="Bold" Visibility="Collapsed" />
                <ListView x:Name="Leagues" SelectionMode="Single" MaxHeight="240"
                    SelectionChanged="Leagues_SelectionChanged" Visibility="Collapsed">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="8" Background="{StaticResource RallySurface}" CornerRadius="8">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Subtitle}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="ChannelsHeader" Text="Live TV" FontSize="19" FontWeight="Bold" Visibility="Collapsed" />
                <ListView x:Name="Channels" SelectionMode="Single" MaxHeight="320"
                    SelectionChanged="Channels_SelectionChanged" Visibility="Collapsed">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="8" Background="{StaticResource RallySurface}" CornerRadius="8">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Subtitle}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="StreamsHeader" Text="Streams" FontSize="19" FontWeight="Bold" Visibility="Collapsed" />
                <ListView x:Name="Streams" SelectionMode="Single" MaxHeight="320"
                    SelectionChanged="Streams_SelectionChanged" Visibility="Collapsed">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="8" Background="{StaticResource RallySurface}" CornerRadius="8">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Subtitle}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
