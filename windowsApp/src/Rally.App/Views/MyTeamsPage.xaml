<Page
    x:Class="Rally.App.Views.MyTeamsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource RallyBackground}">
    <Grid Padding="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="MY TEAMS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource RallyAccent}" VerticalAlignment="Center" />
            <TextBlock Text="Your teams. Their next moments." FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
            <ProgressRing x:Name="Spinner" IsActive="False" Width="24" Height="24" />
        </StackPanel>
        <TextBlock x:Name="ErrorText" Grid.Row="1" Visibility="Collapsed" Opacity="0.7" TextWrapping="Wrap" />
        <StackPanel Grid.Row="2" Spacing="4">
            <TextBlock x:Name="FollowingTitle" Text="FOLLOWING" FontSize="14" FontWeight="SemiBold" />
            <ListView x:Name="Teams" SelectionMode="Single" SelectionChanged="Teams_SelectionChanged" MaxHeight="320">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8" Background="{StaticResource RallySurface}" CornerRadius="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock FontSize="12" Opacity="0.7">
                                    <Run Text="{Binding Abbreviation}" /><Run Text=" · " /><Run Text="{Binding League}" />
                                </TextBlock>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Remove" Click="RemoveTeam_Click" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel x:Name="TeamsEmpty" Visibility="Collapsed" Spacing="8" Padding="8">
                <TextBlock Text="Star teams to build your Games For You." Opacity="0.7" TextWrapping="Wrap" />
                <Button x:Name="ChooseTeams" Content="CHOOSE TEAMS" Click="ChooseTeams_Click" />
            </StackPanel>
        </StackPanel>
        <TextBlock x:Name="GamesTitle" Grid.Row="3" Text="GAMES FOR YOU" FontSize="14" FontWeight="SemiBold" />
        <Grid Grid.Row="4">
            <ListView x:Name="Games" SelectionMode="Single" SelectionChanged="Games_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="8" Background="{StaticResource RallySurface}" CornerRadius="8">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock FontSize="12" Opacity="0.7">
                                <Run Text="{Binding League}" /><Run Text=" · " /><Run Text="{Binding StatusText}" />
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="GamesEmpty" Visibility="Collapsed" Opacity="0.7" TextWrapping="Wrap"
                Text="No favorite-team games are scheduled in the current feed." />
        </Grid>
    </Grid>
</Page>
