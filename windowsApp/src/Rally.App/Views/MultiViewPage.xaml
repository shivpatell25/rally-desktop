<Page
    x:Class="Rally.App.Views.MultiViewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource RallyBackground}">
    <Grid Padding="12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="Multi-View" FontSize="24" FontWeight="Bold" />
            <TextBlock x:Name="TileCount" VerticalAlignment="Center" Opacity="0.7" />
            <TextBlock x:Name="StatusLine" VerticalAlignment="Center" Opacity="0.7" TextWrapping="Wrap" />
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid x:Name="TileGrid" ColumnSpacing="8" RowSpacing="8" />
            <StackPanel x:Name="EmptyState" Spacing="8"
                VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="No games in multi-view" FontSize="18" FontWeight="SemiBold"
                    HorizontalAlignment="Center" />
                <TextBlock Text="Open a game and choose + Multi-View to add it here (max 4 tiles)."
                    Opacity="0.7" TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
