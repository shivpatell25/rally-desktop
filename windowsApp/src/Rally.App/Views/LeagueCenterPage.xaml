<Page
    x:Class="Rally.App.Views.LeagueCenterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource RallyBackground}">
    <Grid Padding="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="12">
            <StackPanel Spacing="2">
                <TextBlock Text="RALLY SPORTS · LEAGUE CENTER" Foreground="{StaticResource RallyAccent}"
                    FontSize="11" FontWeight="Bold" />
                <TextBlock x:Name="Title" FontSize="28" FontWeight="Bold" />
                <TextBlock x:Name="Subtitle" Opacity="0.7" />
            </StackPanel>
            <ProgressRing x:Name="Spinner" IsActive="False" Width="24" Height="24" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button x:Name="GamesTab" Content="Games" Click="Tab_Click" />
            <Button x:Name="StandingsTab" Content="Standings" Click="Tab_Click" />
            <Button x:Name="PlayoffsTab" Content="Playoffs" Click="Tab_Click" />
            <Button x:Name="RedZoneButton" Content="● RedZone" Click="RedZone_Click" Visibility="Collapsed" />
        </StackPanel>
        <StackPanel Grid.Row="2" Spacing="4">
            <StackPanel x:Name="Pager" Orientation="Horizontal" Spacing="8">
                <Button Content="‹" Click="PrevDay_Click" />
                <TextBlock x:Name="DateLabel" Text="TODAY" FontWeight="Bold" VerticalAlignment="Center" />
                <Button Content="›" Click="NextDay_Click" />
                <Button x:Name="TodayButton" Content="Today" Click="Today_Click" Visibility="Collapsed" />
            </StackPanel>
            <TextBlock x:Name="ErrorText" Visibility="Collapsed" Foreground="{StaticResource RallyLive}" TextWrapping="Wrap" />
        </StackPanel>
        <Grid Grid.Row="3">
            <ListView x:Name="Games" SelectionMode="Single"
                SelectionChanged="Games_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="8" Background="{StaticResource RallySurface}" CornerRadius="8">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Detail}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <ListView x:Name="StandingsList" SelectionMode="None" Visibility="Collapsed">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="8" Background="{StaticResource RallySurface}" CornerRadius="8">
                            <TextBlock Text="{Binding TeamName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Line}" FontSize="12" Foreground="{StaticResource RallyAccent}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel x:Name="PlayoffsPanel" Spacing="8" Visibility="Collapsed">
                <TextBlock x:Name="PlayoffSectionLabel" FontWeight="Bold" />
                <ListView x:Name="PlayoffGames" SelectionMode="Single"
                    SelectionChanged="Games_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="8" Background="{StaticResource RallySurface}" CornerRadius="8">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Detail}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <ListView x:Name="PlayoffSeeds" SelectionMode="None" Visibility="Collapsed">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="8" Background="{StaticResource RallySurface}" CornerRadius="8">
                                <TextBlock Text="{Binding TeamName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Line}" FontSize="12" Foreground="{StaticResource RallyAccent}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
            <TextBlock x:Name="EmptyDayText" Text="No games are listed for this date."
                Visibility="Collapsed" Opacity="0.7"
                HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Page>
