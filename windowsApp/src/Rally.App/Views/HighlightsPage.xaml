<Page
    x:Class="Rally.App.Views.HighlightsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource RallyBackground}">
    <Grid Padding="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock Text="HIGHLIGHTS" Foreground="{StaticResource RallyAccent}" FontSize="11" FontWeight="Bold" />
            <TextBlock Text="The biggest moments, right now." FontSize="28" FontWeight="Bold" />
            <TextBlock Text="Event-linked clips from supported leagues." FontSize="13" Opacity="0.7" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <ProgressRing x:Name="Spinner" IsActive="False" Width="24" Height="24" />
            <TextBlock x:Name="ErrorText" Visibility="Collapsed" VerticalAlignment="Center"
                Foreground="{StaticResource RallyLive}" TextWrapping="Wrap" />
            <Button x:Name="RetryButton" Content="Try Again" Visibility="Collapsed" Click="Retry_Click" />
        </StackPanel>
        <Grid Grid.Row="2">
            <TextBlock x:Name="EmptyText" Visibility="Collapsed" Opacity="0.7" TextWrapping="Wrap"
                Text="No league clips have been published yet. This page fills automatically as supported leagues release highlights." />
            <GridView x:Name="Clips" SelectionMode="Single" SelectionChanged="Clips_SelectionChanged">
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="320" Background="{StaticResource RallySurface}" CornerRadius="10" Spacing="0">
                            <Image Source="{Binding ThumbnailUrl}" Height="150" Stretch="UniformToFill" />
                            <StackPanel Padding="15" Spacing="4">
                                <TextBlock Text="{Binding League}" Foreground="{StaticResource RallyAccent}"
                                    FontSize="10" FontWeight="Bold" />
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" TextWrapping="Wrap" MaxLines="2" />
                                <TextBlock FontSize="12" Opacity="0.7" TextWrapping="Wrap" MaxLines="1">
                                    <Run Text="{Binding EventName}" /><Run Text=" · " /><Run Text="{Binding DurationText}" />
                                </TextBlock>
                                <Button Content="View event" Tag="{Binding Event}" Click="EventButton_Click" />
                            </StackPanel>
                        </DataTemplate>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </Grid>
    </Grid>
</Page>
