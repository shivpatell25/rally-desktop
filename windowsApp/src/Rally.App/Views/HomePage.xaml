<Page
    x:Class="Rally.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource RallyBackground}">
    <Grid Padding="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="Rally" FontSize="28" FontWeight="Bold" />
            <ProgressRing x:Name="Spinner" IsActive="False" Width="24" Height="24" />
            <Button x:Name="RetryButton" Content="Retry" Click="Retry_Click" Visibility="Collapsed" />
        </StackPanel>
        <TextBlock x:Name="ErrorText" Grid.Row="1" Opacity="0.7" TextWrapping="Wrap" Visibility="Collapsed" />
        <ScrollViewer Grid.Row="2">
            <StackPanel x:Name="SectionsHost" Spacing="16" />
        </ScrollViewer>
    </Grid>
</Page>
