<Page
    x:Class="Rally.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource RallyBackground}">
    <Grid Padding="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="Rally" FontSize="28" FontWeight="Bold" />
            <ProgressRing x:Name="Spinner" IsActive="False" Width="24" Height="24" />
        </StackPanel>
        <ListView x:Name="Events" Grid.Row="1" SelectionMode="Single"
            SelectionChanged="Events_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Padding="8" Background="{StaticResource RallySurface}" CornerRadius="8">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock FontSize="12" Opacity="0.7">
                            <Run Text="{Binding League}" /><Run Text=" · " /><Run Text="{Binding StatusText}" />
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
