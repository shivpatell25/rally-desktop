<Page
    x:Class="Rally.App.Views.EventDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource RallyBackground}">
    <ScrollViewer Padding="20">
        <StackPanel x:Name="Root" Spacing="12" MaxWidth="960">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <ProgressRing x:Name="Spinner" IsActive="False" Width="24" Height="24" />
                <TextBlock x:Name="ErrorText" Opacity="0.7" TextWrapping="Wrap" VerticalAlignment="Center" Visibility="Collapsed" />
            </StackPanel>
            <Border Background="{StaticResource RallySurface}" CornerRadius="12" Padding="20">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border x:Name="StatusPill" CornerRadius="12" Padding="12,6,12,6"
                            Background="{StaticResource RallyLive}">
                            <TextBlock x:Name="StatusPillText" Text="UPCOMING" FontSize="11" FontWeight="Bold" />
                        </Border>
                        <TextBlock x:Name="LeagueText" Opacity="0.7" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" HorizontalAlignment="Center">
                            <TextBlock x:Name="AwayName" FontSize="18" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock x:Name="AwayAbbr" Opacity="0.7" FontSize="12" TextAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" MinWidth="140">
                            <TextBlock x:Name="ScoreText" FontSize="30" FontWeight="Bold" TextAlignment="Center" />
                            <TextBlock x:Name="StartText" Opacity="0.7" FontSize="11" FontWeight="SemiBold" TextAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2" HorizontalAlignment="Center">
                            <TextBlock x:Name="HomeName" FontSize="18" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock x:Name="HomeAbbr" Opacity="0.7" FontSize="12" TextAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="VenueText" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="WatchButton" Content="Watch" Click="Watch_Click" />
                        <Button Content="Pick source" Click="PickSource_Click" />
                        <Button x:Name="SaveAwayButton" Content="Save away" Click="SaveAway_Click" />
                        <Button x:Name="SaveHomeButton" Content="Save home" Click="SaveHome_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource RallySurface}" CornerRadius="10" Padding="12">
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="MatchupTitle" FontSize="14" FontWeight="Bold" Text="MATCHUP PREVIEW" />
                        <StackPanel x:Name="MatchupRows" Spacing="4" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="{StaticResource RallySurface}" CornerRadius="10" Padding="12">
                    <StackPanel Spacing="6">
                        <TextBlock FontSize="14" FontWeight="Bold" Text="TEAM OUTLOOK" />
                        <TextBlock x:Name="AwayOutlook" TextWrapping="Wrap" FontSize="12" Opacity="0.85" />
                        <TextBlock x:Name="HomeOutlook" TextWrapping="Wrap" FontSize="12" Opacity="0.85" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{StaticResource RallySurface}" CornerRadius="10" Padding="12">
                    <StackPanel Spacing="6">
                        <TextBlock FontSize="14" FontWeight="Bold" Text="GAME INFORMATION" />
                        <StackPanel x:Name="InfoRows" Spacing="4" />
                    </StackPanel>
                </Border>
            </Grid>
            <Border Background="{StaticResource RallySurface}" CornerRadius="10" Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="LeadersTitle" FontSize="14" FontWeight="Bold" Text="TOP PERFORMERS" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="AwayLeaders" Spacing="4" />
                        <StackPanel x:Name="HomeLeaders" Grid.Column="1" Spacing="4" />
                    </Grid>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource RallySurface}" CornerRadius="10" Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="ClipsTitle" FontSize="14" FontWeight="Bold" Text="HIGHLIGHTS" />
                    <StackPanel x:Name="ClipsHost" Spacing="6" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="DetailErrorText" Opacity="0.6" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</Page>
