<Page
    x:Class="Rally.App.Views.GameViewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vlc="using:LibVLCSharp.Platforms.Windows"
    Background="{StaticResource RallyBackground}">
    <Grid ColumnSpacing="12" Padding="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="GameTitle" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" />
            <vlc:VideoView x:Name="Video" Grid.Row="1" />
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                <Button Content="Pause" Click="Pause_Click" />
                <Button Content="Restart" Click="Restart_Click" />
                <Button Content="Retry" Click="Retry_Click" />
                <TextBlock x:Name="NowPlaying" VerticalAlignment="Center" Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Row="3" Spacing="4">
                <TextBlock x:Name="ErrorLine" Foreground="{StaticResource RallyLive}" TextWrapping="Wrap" Visibility="Collapsed" />
                <TextBlock Text="Other live" FontSize="16" FontWeight="SemiBold" />
                <ListView x:Name="LiveStrip" SelectionMode="Single"
                    SelectionChanged="LiveStrip_SelectionChanged">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="220" Padding="8"
                                Background="{StaticResource RallySurface}" CornerRadius="8">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                    TextWrapping="Wrap" MaxLines="2" />
                                <TextBlock Text="{Binding Subtitle}" FontSize="12" Opacity="0.7" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Grid>
        <TabView Grid.Column="1" x:Name="Tabs"
            IsAddTabButtonVisible="False" CanDragTabs="False" CanReorderTabs="False">
            <TabViewItem Header="Detail" IsClosable="False">
                <ListView x:Name="DetailList" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="6">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Subtitle}" FontSize="12" Opacity="0.7"
                                    TextWrapping="Wrap" Visibility="{Binding HasSubtitle}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </TabViewItem>
            <TabViewItem Header="Stats" IsClosable="False">
                <ListView x:Name="StatsList" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="6">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Subtitle}" FontSize="12" Opacity="0.7"
                                    TextWrapping="Wrap" Visibility="{Binding HasSubtitle}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </TabViewItem>
            <TabViewItem Header="Clips" IsClosable="False">
                <ListView x:Name="ClipsList" SelectionMode="Single"
                    SelectionChanged="Clips_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="6">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Subtitle}" FontSize="12" Opacity="0.7"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </TabViewItem>
        </TabView>
    </Grid>
</Page>
