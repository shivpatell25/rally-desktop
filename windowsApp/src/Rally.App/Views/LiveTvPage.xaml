<Page
    x:Class="Rally.App.Views.LiveTvPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource RallyBackground}">
    <Grid ColumnSpacing="16" Padding="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="LIVE TV" FontSize="11" FontWeight="Bold" Opacity="0.6" />
            <ListView x:Name="Categories" Grid.Row="1" SelectionMode="Single"
                SelectionChanged="Categories_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="13" Padding="14,11" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Button Grid.Row="2" Content="Refresh" Click="Refresh_Click" />
        </Grid>
        <Grid Grid.Column="1" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                    <TextBlock x:Name="CategoryTitle" Text="All" FontSize="28" FontWeight="Bold" />
                    <TextBlock x:Name="Counts" FontSize="13" Opacity="0.7" />
                </StackPanel>
                <AutoSuggestBox x:Name="Search" Grid.Column="1" VerticalAlignment="Center"
                    PlaceholderText="Search channels"
                    TextChanged="Search_TextChanged" />
            </Grid>
            <Grid Grid.Row="1">
                <ListView x:Name="Channels" SelectionMode="Single" Visibility="Collapsed"
                    SelectionChanged="Channels_SelectionChanged"
                    ContainerContentChanging="Channels_ContainerContentChanging">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="12" ColumnSpacing="12" Background="{StaticResource RallySurface}" CornerRadius="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="48" Height="48">
                                    <TextBlock Text="{Binding Fallback}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                                    <Image Source="{Binding LogoImage}" Width="48" Height="48" />
                                </Grid>
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Number}" /><Run Text=" · " /><Run Text="{Binding Name}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding NowText}" FontSize="12" Opacity="0.9"
                                        TextTrimming="CharacterEllipsis" Visibility="{Binding NowVisibility}" />
                                    <TextBlock Text="{Binding NextText}" FontSize="12" Opacity="0.7"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding QualityBadge}" FontSize="11" FontWeight="Bold"
                                        Visibility="{Binding QualityVisibility}" />
                                    <TextBlock Text="CATCH-UP" FontSize="11" FontWeight="Bold"
                                        Foreground="{StaticResource RallyLime}" Visibility="{Binding CatchUpVisibility}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel x:Name="LoadingState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <ProgressRing x:Name="Spinner" IsActive="True" Width="32" Height="32" HorizontalAlignment="Center" />
                    <TextBlock Text="Loading your channels" Opacity="0.7" />
                </StackPanel>
                <StackPanel x:Name="NoProviderState" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="6" Visibility="Collapsed">
                    <TextBlock Text="No provider configured" FontSize="21" FontWeight="SemiBold"
                        TextAlignment="Center" />
                    <TextBlock Text="Add your portal details in Settings." FontSize="14" Opacity="0.7"
                        TextAlignment="Center" />
                </StackPanel>
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="6" Visibility="Collapsed">
                    <TextBlock x:Name="EmptyTitle" FontSize="21" FontWeight="SemiBold" TextAlignment="Center" />
                    <TextBlock x:Name="EmptySubtitle" FontSize="14" Opacity="0.7" TextAlignment="Center" />
                    <Button x:Name="EmptyRetry" Content="Try Again" Click="Refresh_Click"
                        HorizontalAlignment="Center" Visibility="Collapsed" />
                </StackPanel>
                <StackPanel x:Name="ErrorState" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="6" Visibility="Collapsed">
                    <TextBlock Text="Live TV is unavailable" FontSize="21" FontWeight="SemiBold"
                        TextAlignment="Center" />
                    <TextBlock x:Name="ErrorMessage" FontSize="14" Opacity="0.7" TextAlignment="Center"
                        TextWrapping="Wrap" MaxWidth="480" />
                    <Button Content="Try Again" Click="Refresh_Click" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
